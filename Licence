## 📁 FILE 11: `app/src/main/java/com/sanji/bomberpro/SanjiApp.kt`

```kotlin
package com.sanji.bomberpro

import android.app.Application
import android.app.NotificationChannel
import android.app.NotificationManager
import android.content.Context
import android.os.Build
import com.google.firebase.FirebaseApp
import com.google.firebase.firestore.FirebaseFirestore
import com.google.firebase.firestore.FirebaseFirestoreSettings
import com.google.firebase.firestore.PersistentCacheSettings
import com.google.firebase.messaging.FirebaseMessaging

/**
 * Application class — initializes Firebase, crash handler, notification channels.
 */
class SanjiApp : Application() {

    override fun onCreate() {
        super.onCreate()

        // Firebase
        FirebaseApp.initializeApp(this)

        // Firestore — offline persistence + cache (secure)
        val firestore = FirebaseFirestore.getInstance()
        val settings = FirebaseFirestoreSettings.Builder()
            .setLocalCacheSettings(
                PersistentCacheSettings.newBuilder()
                    .setSizeBytes(100L * 1024 * 1024) // 100MB cache
                    .build()
            )
            .build()
        firestore.firestoreSettings = settings

        // Notification channels
        createNotificationChannels()

        // Subscribe to FCM topic for broadcasts
        FirebaseMessaging.getInstance().subscribeToTopic("all_users")

        // Install global crash handler that logs to Firestore (admin panel)
        installCrashHandler()
    }

    private fun createNotificationChannels() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager

            NotificationChannel(
                CHANNEL_DEFAULT,
                "General",
                NotificationManager.IMPORTANCE_DEFAULT
            ).apply {
                description = "General notifications"
                nm.createNotificationChannel(this)
            }

            NotificationChannel(
                CHANNEL_BLAST,
                "Blast progress",
                NotificationManager.IMPORTANCE_LOW
            ).apply {
                description = "SMS blast live progress"
                setShowBadge(false)
                nm.createNotificationChannel(this)
            }

            NotificationChannel(
                CHANNEL_PAYMENT,
                "Payment updates",
                NotificationManager.IMPORTANCE_HIGH
            ).apply {
                description = "Payment approved / rejected"
                nm.createNotificationChannel(this)
            }

            NotificationChannel(
                CHANNEL_OTP,
                "OTP alerts",
                NotificationManager.IMPORTANCE_HIGH
            ).apply {
                description = "New OTP found by auto-detect"
                nm.createNotificationChannel(this)
            }

            NotificationChannel(
                CHANNEL_ADMIN,
                "Admin",
                NotificationManager.IMPORTANCE_HIGH
            ).apply {
                description = "Admin notifications (broadcast, tickets)"
                nm.createNotificationChannel(this)
            }
        }
    }

    private fun installCrashHandler() {
        val previous = Thread.getDefaultUncaughtExceptionHandler()
        Thread.setDefaultUncaughtExceptionHandler { thread, throwable ->
            try {
                val crashRef = FirebaseFirestore.getInstance().collection("crash_logs").document()
                crashRef.set(
                    mapOf(
                        "thread" to thread.name,
                        "message" to (throwable.message ?: "unknown"),
                        "stack" to throwable.stackTraceToString().take(4000),
                        "appVersion" to BuildConfig.VERSION_NAME,
                        "device" to "${Build.MANUFACTURER} ${Build.MODEL}",
                        "android" to Build.VERSION.SDK_INT,
                        "ts" to System.currentTimeMillis() / 1000L,
                    )
                )
            } catch (_: Throwable) {
                // Never crash in crash handler
            }
            previous?.uncaughtException(thread, throwable)
        }
    }

    companion object {
        const val CHANNEL_DEFAULT = "sanji_default_channel"
        const val CHANNEL_BLAST = "sanji_blast_channel"
        const val CHANNEL_PAYMENT = "sanji_payment_channel"
        const val CHANNEL_OTP = "sanji_otp_channel"
        const val CHANNEL_ADMIN = "sanji_admin_channel"
    }
}